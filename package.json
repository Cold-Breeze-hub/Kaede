{
  "name": "kaede",
  "version": "0.0.0",
  "private": true,
  "description": "Kaede · ACGN 多源聚合桌面软件（Spike-1 骨架：Electron 壳 + 契约类型）",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"cross-env ELECTRON_RENDERER_URL=http://localhost:5173 wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && node scripts/check-redline.mjs",
    "redline": "node scripts/check-redline.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^8.0.0"
  }
}
